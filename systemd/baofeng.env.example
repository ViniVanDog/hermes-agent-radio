# Copy to ~/.config/baofeng-radio/baofeng.env and edit. Read by the units in this folder.
# Every unit assumes this repo is checked out at ~/hermes-agent-radio.

# Language the radio speaks: en or pt-BR. Picks the spoken-text fixes, the
# context handoff note, the example tools' replies and the local STT default.
BAOFENG_LANG=en

# --- Host PC (the machine on the same LAN as the ESP32; USB to the ESP32) ---
# Where the relay forwards RX audio: the Hermes VM (or 127.0.0.1 if Hermes runs here).
VM_HOST=192.0.2.20
# The ESP32's LAN address (printed on its serial console). Only its packets are relayed.
RADIO_HOST=192.0.2.30
# Scanner controller: address it listens on, and the one client allowed to drive it
# (the dashboard host). Keep both on a private network.
SCANNER_BIND=192.0.2.1
SCANNER_CLIENT=192.0.2.20

# --- Hermes VM ---
# The ESP32 again, as seen from the VM: TTS audio goes straight to it on UDP 7778.
ESP32_HOST=192.0.2.30
# Dashboard -> scanner controller on the host PC.
BAOFENG_SCANNER_URL=http://192.0.2.1:8788
